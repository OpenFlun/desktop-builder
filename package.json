{
    "name": "@flun/desktop-builder",
    "version": "5.2.0",
    "description": "将任意 Node.js 网站一键打包为当前桌面应用(\u0027win\u0027, \u0027mac\u0027, \u0027linux\u0027)（基于 Electron）,支持高度自定义配置;",
    "type": "module",
    "types": "index.d.ts",
    "exports": {
        ".": "./index.js"
    },
    "main": "index.js",
    "bin": {
        "desktop-builder": "./index.js"
    },
    "scripts": {
        "postinstall": "node copy-files.js 2\u003e\u00261"
    },
    "keywords": [
        "electron",
        "desktop",
        "nodejs",
        "packager",
        "installer",
        "nsis",
        "dmg",
        "appimage"
    ],
    "author": "flun \u003copen@flun.top\u003e",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenFlun/desktop-builder.git"
    },
    "homepage": "https://github.com/OpenFlun/desktop-builder#readme",
    "bugs": {
        "url": "https://github.com/OpenFlun/desktop-builder/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "build/",
        "build.js",
        "optimize-node-modules.js",
        "copy-files.js",
        "desktopAppConfig.js",
        "electron-main.js",
        "index.js",
        "index.d.ts",
        "LICENSE",
        "CHANGELOG.md",
        "README.md"
    ],
    "dependencies": {
        "adm-zip": "^0.6.1",
        "electron": "^44.5.1",
        "electron-builder": "^27.0.0-alpha.9",
        "execa": "^10.0.1",
        "fs-extra": "^11.4.1",
        "chalk": "^6.0.1",
        "glob": "13.0.6",
        "rimraf": "6.1.3",
        "minimatch": "^10.2.6",
        "esbuild": "^0.28.2"
    },
    "engines": {
        "node": "\u003e=22.12.0",
        "npm": "\u003e=10.0.0"
    }
}