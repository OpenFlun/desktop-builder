{
  "name": "@flun/desktop-builder",
  "version": "4.1.3",
  "description": "将任意 Node.js 网站一键打包为当前桌面应用('win', 'mac', 'linux')（基于 Electron）,支持高度自定义配置;",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js"
  },
  "main": "index.js",
  "bin": {
    "desktop-builder": "./index.js"
  },
  "scripts": {
    "postinstall": "node copy-files.js 2>&1"
  },
  "keywords": [
    "electron",
    "desktop",
    "nodejs",
    "packager",
    "installer",
    "nsis",
    "dmg",
    "appimage"
  ],
  "author": "flun <open@flun.top>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFlun/desktop-builder.git"
  },
  "homepage": "https://github.com/OpenFlun/desktop-builder#readme",
  "bugs": {
    "url": "https://github.com/OpenFlun/desktop-builder/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build/",
    "build.js",
    "copy-files.js",
    "desktopAppConfig.js",
    "electron-main.js",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "chalk": "^6.0.0",
    "glob": "13.0.6",
    "rimraf": "6.1.3",
    "minimatch": "^10.2.6"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}